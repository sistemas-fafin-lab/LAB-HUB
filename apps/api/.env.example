# Copie para .env e preencha. NUNCA commitar o .env real.

# Supabase LAB-HUB (chave secreta — server-side apenas, ignora RLS)
SUPABASE_URL=https://<projeto>.supabase.co
#
# Formato NOVO, revogável isoladamente (Project Settings → API Keys).
# Prefira este: a chave legada abaixo é um JWT assinado com o segredo do
# projeto, e revogá-la exige rotacionar esse segredo — o que invalida TODAS as
# sessões de todos os pacientes de uma vez (auditoria § S-10).
SUPABASE_SECRET_KEY=sb_secret_...
#
# Legada. Ainda aceita como reserva enquanto a migração não termina em produção;
# se estiver no formato `eyJ…`, a API avisa no boot. Depois de trocar tudo,
# apague esta linha e desative a chave no painel.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# FlowLab — base das funções de integração (server-to-server).
# As funções vivem no app FlowLab como rotas Vercel em /api/analises-clinicas.
#   dev:  http://localhost:3000/api/analises-clinicas  (vercel dev do FlowLab)
#   prod: https://<flowlab>.vercel.app/api/analises-clinicas
FLOWLAB_EDGE_FUNCTION_URL=http://localhost:3000/api/analises-clinicas
# DEVE ser idêntico ao FLOWLAB_API_KEY do FlowLab (Bearer enviado em cada chamada).
FLOWLAB_API_KEY=<chave-de-acesso>
# Timeout (ms) das chamadas ao FlowLab; evita travar o POST /agendamentos. Default: 8000.
FLOWLAB_TIMEOUT_MS=8000
# TTL (ms) do cache em memória da disponibilidade de postos, só para exibição
# (GET /postos/disponibilidade) — evita o cold start da Edge Function a cada
# acesso. A CRIAÇÃO de agendamento não usa este cache: valida o slot ao vivo,
# então aumentar isto nunca causa agendamento duplo; no pior caso a tela mostra
# um horário recém-tomado até o TTL expirar. Default: 30000. 0 desliga o cache.
FLOWLAB_DISPONIBILIDADE_TTL_MS=30000

# Segredo HMAC compartilhado p/ validar webhooks do FlowLab.
# DEVE ser idêntico ao LABHUB_WEBHOOK_SECRET do FlowLab (mesmo valor, nome diferente).
FLOWLAB_WEBHOOK_SECRET=<hmac-secret-compartilhado>

# ---------------------------------------------------------------------------
# LIS do laboratório — origem dos laudos (GET /api/v1/laudos).
# Segunda fonte de resultado, independente do webhook do FlowLab acima.
# Ver docs/LAUDOS_LIS.md.
# ---------------------------------------------------------------------------

# ApLIS — REST/JSON. Usuário e senha são OPCIONAIS: instalações que liberam por
# IP dispensam o Basic auth. Sem eles a chamada sai sem Authorization.
APLIS_BASE_URL=https://lab.aplis.inf.br/api/integracao.php
APLIS_USUARIO=<usuario-aplis>
APLIS_SENHA=<senha-aplis>
# Janela retroativa (dias) da busca de requisições — vale para o ApLIS E para a
# listagem de OS da AOL. Cuidado ao mexer, nas DUAS direções:
#   aumentar → nenhum dos dois LIS filtra por paciente na listagem, então o
#              período inteiro é varrido e filtrado aqui; dobrar o período dobra
#              as páginas por refresh (~47s numa janela de 90 dias).
#   diminuir → exame mais antigo que a janela e ainda não descoberto NUNCA entra
#              (o que já está em exam_results segue sendo servido do cache).
# Default do código também é 90, de propósito: se esta linha sumir do .env, o
# comportamento não encolhe silenciosamente. Valor inválido cai no default com
# aviso no boot, em vez de virar NaN.
APLIS_PERIODO_DIAS=90

# AOL (Álvaro Online) — XML. Todas obrigatórias para o caminho AOL funcionar.
# Mantenha HTTPS: trafegam credenciais Basic e laudo de paciente.
AOL_BASE_URL=https://webservice.alvaro.com.br
AOL_IDAGENTE=<id-do-agente>
AOL_SENHA=<senha-do-agente>
AOL_ENTIDADE=<codigo-da-entidade>

# Por quanto tempo um laudo já buscado é servido sem reconsultar os LIS.
EXAM_CACHE_TTL_HOURS=24

# Corte de EXIBIÇÃO por fonte (decisão de operação, não técnica):
#   true  (padrão) → o portal mostra só laudo com valor medido no Álvaro Online.
#                    A requisição que existe apenas no ApLIS, sem OS no Álvaro,
#                    não aparece na lista nem sai por GET /laudos/:id.
#   false          → volta a mostrar as duas fontes.
# NÃO desliga o ApLIS: ele continua descobrindo as requisições (é o que liga a
# OS do Álvaro ao paciente) e o laudo ApLIS-only continua sendo cacheado. Por
# isso voltar para false devolve os laudos na hora, sem refazer busca nos LIS.
LAUDOS_SOMENTE_ALVARO=true

# Fluxo de confirmação de e-mail no cadastro:
#   false (fase de testes) → não envia e-mail; o paciente entra direto após cadastrar
#   true  (produção)       → envia e-mail de confirmação; login só após confirmar
#
# Com `false`, QUALQUER PESSOA cria conta com o e-mail de outra e já entra
# logada (S-05). Ficou `false` enquanto não havia SMTP: o projeto usava o
# serviço embutido do Supabase, limitado a 2 e-mails/hora, e ligar a
# confirmação sem isso trancava o cadastro — o paciente criava a conta, não
# recebia nada e não conseguia entrar.
#
# Desde 31/07/2026 há SMTP próprio (Google Workspace, ver S-05 na auditoria) e
# a entrega foi comprovada de ponta a ponta. Em produção isto é `true`.
REQUIRE_EMAIL_CONFIRMATION=true

# ---------------------------------------------------------------------------
# Criptografia do dado clínico em repouso (S-06)
# ---------------------------------------------------------------------------
# Chave AES-256 em base64. Gere com:
#
#   openssl rand -base64 32
#
# OBRIGATÓRIA em produção: sem ela o boot FALHA, de propósito. Laudo gravado em
# texto puro é um controle que todos acreditam existir e não existe; API fora do
# ar é ruidoso e se resolve em um minuto.
#
# ORDEM DO DEPLOY: defina esta variável no .env do VPS ANTES de `docker compose
# up -d --build`. Ao contrário, o container não sobe.
#
# A chave protege contra vazamento LÓGICO (dump, backup, réplica, staging com
# dado real, acesso indevido ao Studio). Por isso ela mora aqui e NUNCA no
# Supabase — chave e cadeado na mesma gaveta não protegem de nada.
#
# PERDER A CHAVE = PERDER OS DADOS. Guarde uma cópia em cofre (1Password/
# Bitwarden) SEPARADO do backup do banco. Se o backup da chave ficar junto do
# backup do banco, você não ganhou nada.
PII_KEY_K1=<base64-de-32-bytes>
#
# Rotação (quando for a hora): acrescente PII_KEY_K2 com a chave nova — ela
# passa a ser a de ESCRITA automaticamente (maior número vence) enquanto a K1
# segue decifrando o que já existe. Rode `npm run backfill-cripto` para re-cifrar
# e só então remova a K1. Para forçar qual é a de escrita durante a transição:
# PII_CHAVE_ATUAL=k1

# Origens permitidas no CORS (separadas por vírgula). Uma entrada entre barras
# vira RegExp — útil p/ os previews da Vercel: /^https:\/\/.*\.vercel\.app$/
# OBRIGATÓRIA em produção: omitir NÃO libera geral, cai no fallback de dev
# (qualquer porta de localhost e 127.0.0.1), que bloqueia o frontend hospedado.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Quantos saltos de proxy confiar para descobrir o IP do cliente (X-Forwarded-For).
# 1 = a topologia atual (só o túnel ngrok do docker-compose na frente da API).
# Suba para 2 se entrar um CDN/reverse proxy adicional, e desça para 0 se algum
# dia a API for exposta direto. Não existe "true" aqui de propósito: confiar na
# cadeia inteira deixaria o cliente escolher o próprio IP, e ele vai para a
# trilha de auditoria (S-08) e para a chave do rate-limit.
TRUST_PROXY_HOPS=1

PORT=3333
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Retenção de documentos (S-09) — usado só pela rotina `npm run expurgo`
# ---------------------------------------------------------------------------
# Prazos até apagar o documento do paciente do bucket, ao fim da finalidade
# (LGPD art. 15/16). São decisão do laboratório, não do código; os padrões
# erram para o lado de reter um pouco mais, que é o lado recuperável.
#
# Documento DE COLETA (pedido médico): contado a partir do `data_hora` do
# agendamento, não do upload — o que importa é quando a coleta ocorreu.
RETENCAO_DOC_COLETA_DIAS=90
#
# Documento PERENE (identidade, carteirinha): só é apagado se o paciente
# estiver INATIVO na janela, isto é, sem nenhuma coleta nela. Quem volta todo
# mês nunca tem a identidade apagada, e é o certo — a finalidade dura enquanto
# durar a relação.
RETENCAO_DOC_PERENE_MESES=24
