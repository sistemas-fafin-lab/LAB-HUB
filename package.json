{
  "name": "lab-hub",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:api": "concurrently --names api,ngrok -c cyan,magenta \"npm run dev:api:solo\" \"npm run tunnel\"",
    "dev:api:solo": "npm run dev --workspace=apps/api",
    "tunnel": "ngrok http --url=https://scrubbier-songless-connor.ngrok-free.dev 3000 --log=stdout",
    "build": "npm run build --workspace=apps/web",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "metro": "0.83.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "dependencies": {
    "mermaid": "^11.15.0"
  }
}
