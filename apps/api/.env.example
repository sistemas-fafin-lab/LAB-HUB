# Copie para .env e preencha. NUNCA commitar o .env real.

# Supabase LAB-HUB (service role — server-side apenas)
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# FlowLab — Edge Functions (server-to-server)
FLOWLAB_EDGE_FUNCTION_URL=https://<flowlab-projeto>.supabase.co/functions/v1
FLOWLAB_API_KEY=<chave-de-acesso>

# Segredo HMAC compartilhado p/ validar webhooks do FlowLab
FLOWLAB_WEBHOOK_SECRET=<hmac-secret-compartilhado>

# Fluxo de confirmação de e-mail no cadastro:
#   false (fase de testes) → não envia e-mail; o paciente entra direto após cadastrar
#   true  (produção)       → envia e-mail de confirmação; login só após confirmar
REQUIRE_EMAIL_CONFIRMATION=false

# Origens permitidas no CORS (separadas por vírgula). Em produção, use o domínio exato do frontend.
# Se omitido, libera http://localhost:5173 e http://localhost:3000 (dev).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

PORT=3333
HOST=0.0.0.0
